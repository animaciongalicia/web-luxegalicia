# URL canónica del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=https://www.luxegalicia.com

# Google Analytics 4 (G-XXXXXXXXXX). Vacío = sin analítica.
NEXT_PUBLIC_GA_ID=

# Código de verificación de Google Search Console (meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=

# Endpoint del formulario de presupuesto (Formspree, Resend, Make...). Vacío = abre el email.
NEXT_PUBLIC_FORM_ENDPOINT=

# Datos legales para el pie y las páginas legales
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_TAX_ID=
NEXT_PUBLIC_LEGAL_ADDRESS=
